# Server-only FastAPI upstream. Use http://backend:8000 inside an existing deployment network.
BACKEND_URL=http://127.0.0.1:8000
# Optional WebSocket origin. Empty uses this frontend's origin (/ws must be forwarded).
PUBLIC_API_URL=
# Analytics upstream stays private; only its website ID reaches the browser.
UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PORT=3000
HOST=0.0.0.0
