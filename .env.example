# Server-only FastAPI upstream. Use http://backend:8000 inside an existing deployment network.
BACKEND_URL=http://127.0.0.1:8000
# Conversation and audio requests use the same-origin /api proxy; no public API URL is needed.
# Analytics upstream stays private; only its website ID reaches the browser.
UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PORT=3000
HOST=0.0.0.0
